# Copy to .env and adjust. `.env` is git-ignored.

# PostgreSQL connection string (matches docker-compose.yml).
DATABASE_URL=postgres://retinax:retinax@localhost:5432/retinax

# Bearer token clients send as `Authorization: Bearer <token>`. At least 32 characters.
# Generate one with: openssl rand -hex 32
API_TOKEN=

# Address to listen on. Use 0.0.0.0:8080 to accept connections from other machines.
BIND_ADDR=127.0.0.1:8080

# Connection pool size.
DB_MAX_CONNECTIONS=5

# Log filter (tracing EnvFilter syntax).
RUST_LOG=offchain_server=info,tower_http=info
